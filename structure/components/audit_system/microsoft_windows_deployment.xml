<component
  name="Microsoft-Windows-Deployment"
  processorArchitecture="amd64"
  publicKeyToken="31bf3856ad364e35"
  language="neutral"
  versionScope="nonSxS"
  xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
>
  <!-- Configures Windows deployment settings for Audit System mode -->
  <Reseal>
    <!-- In auditSystem, reseal is set to Audit to boot into System Audit Mode -->
    <Mode>Audit</Mode>
  </Reseal>
  <RunSynchronous>
    <!-- Commands executed synchronously during auditSystem -->
    <RunSynchronousCommand wcm:action="add">
      <Order>1</Order>
      <Description>Run system audit preparation script</Description>
      <Path>C:\Audit\PrepareAuditSystem.ps1</Path>
    </RunSynchronousCommand>
    <RunSynchronousCommand wcm:action="add">
      <Order>2</Order>
      <Description>Install audit utilities</Description>
      <Path>C:\Audit\InstallTools.cmd</Path>
    </RunSynchronousCommand>
  </RunSynchronous>
  <RunAsynchronous>
    <!-- Optional asynchronous commands during auditSystem -->
    <RunAsynchronousCommand wcm:action="add">
      <Order>1</Order>
      <Description>Background monitoring service</Description>
      <Path>C:\Audit\BackgroundService.cmd</Path>
    </RunAsynchronousCommand>
  </RunAsynchronous>
  <ExtendOSPartition>false</ExtendOSPartition>
  <!-- Partition extension typically disabled in auditSystem -->
  <Respecialize>false</Respecialize>
  <!-- Respecialize not needed in auditSystem -->
  <DoNotCleanUpNonPresentDevices>true</DoNotCleanUpNonPresentDevices>
  <!-- Keep non-present drivers for audit/testing purposes -->
  <Generalize>false</Generalize>
  <!-- Generalize is not performed in auditSystem -->
</component>
