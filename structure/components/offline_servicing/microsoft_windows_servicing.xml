<component
  name="Microsoft-Windows-Servicing"
  processorArchitecture="amd64"
  publicKeyToken="31bf3856ad364e35"
  language="neutral"
  versionScope="nonSxS"
  xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
>
  <!-- Configures Windows servicing, package management, and feature installation -->
  <Package>
    <!-- Adds or removes a Windows package -->
    <Action>Install</Action>
    <!-- Options: Install | Remove -->
    <PackageName>Microsoft-Windows-Foundation-Package</PackageName>
    <!-- Name of the package to be installed or removed -->
    <Source>C:\Packages\WindowsFoundation.cab</Source>
    <!-- Path to the package source file -->
  </Package>
  <Package>
    <Action>Remove</Action>
    <PackageName>Microsoft-Windows-Sample-Package</PackageName>
    <!-- Removes this sample package -->
  </Package>
  <WindowsFeatures>
    <!-- Enables or disables optional Windows features -->
    <Feature wcm:action="add">
      <Name>TelnetClient</Name>
      <!-- Name of the feature -->
      <State>Enabled</State>
      <!-- Options: Enabled | Disabled -->
    </Feature>
    <Feature wcm:action="add">
      <Name>Microsoft-Hyper-V-All</Name>
      <State>Disabled</State>
    </Feature>
  </WindowsFeatures>
  <MicrosoftWindowsPnpCustomizationsNonWinPE>
    <!-- Adds or removes driver packages during servicing -->
    <DriverPaths>
      <PathAndCredentials wcm:action="add">
        <Path>C:\Drivers\Network</Path>
        <!-- Path to the driver folder -->
        <Credentials>
          <Domain>CONTOSO</Domain>
          <!-- Optional domain for accessing driver share -->
          <Username>DriverUser</Username>
          <!-- Optional username for accessing driver share -->
          <Password>
            <Value>DriverPass123</Value>
            <PlainText>true</PlainText>
          </Password>
        </Credentials>
      </PathAndCredentials>
      <PathAndCredentials wcm:action="add">
        <Path>D:\Drivers\Video</Path>
      </PathAndCredentials>
    </DriverPaths>
  </MicrosoftWindowsPnpCustomizationsNonWinPE>
  <EnableFeature>
    <!-- Alternate way to enable features (if supported) -->
    <Name>.NETFramework3.5</Name>
    <!-- Feature name -->
    <State>Enabled</State>
    <!-- Enabled or Disabled -->
    <Source>C:\Sources\SxS</Source>
    <!-- Optional source path for feature binaries -->
  </EnableFeature>
  <DisableFeature>
    <!-- Alternate way to disable features (if supported) -->
    <Name>SMB1Protocol</Name>
    <!-- Feature name -->
    <State>Disabled</State>
  </DisableFeature>
</component>
