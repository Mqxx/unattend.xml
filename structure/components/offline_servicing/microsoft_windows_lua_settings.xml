<component
  name="Microsoft-Windows-LUA-Settings"
  processorArchitecture="amd64"
  publicKeyToken="31bf3856ad364e35"
  language="neutral"
  versionScope="nonSxS"
  xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
>
  <!-- Configures User Account Control (UAC) settings during offline servicing -->
  <EnableLUA>true</EnableLUA>
  <!-- Enables or disables User Account Control (UAC)
       true  = UAC is enabled (recommended)
       false = UAC is disabled (not recommended) -->
  <ConsentPromptBehaviorAdmin>2</ConsentPromptBehaviorAdmin>
  <!-- Determines the prompt behavior for administrators:
       0 = Elevate without prompting
       1 = Prompt for credentials on the secure desktop
       2 = Prompt for consent on the secure desktop
       3 = Prompt for credentials
       4 = Prompt for consent
       5 = Prompt for consent for non-Windows binaries -->
  <ConsentPromptBehaviorUser>1</ConsentPromptBehaviorUser>
  <!-- Determines the prompt behavior for standard users:
       0 = Automatically deny elevation requests
       1 = Prompt for credentials on the secure desktop -->
  <PromptOnSecureDesktop>true</PromptOnSecureDesktop>
  <!-- Specifies whether UAC prompts appear on the secure desktop:
       true  = Prompt appears on secure desktop (recommended)
       false = Prompt appears on the normal desktop -->
  <EnableInstallerDetection>true</EnableInstallerDetection>
  <!-- Enables or disables detection of application installers that require elevation:
       true  = Installer detection enabled (default)
       false = Installer detection disabled -->
  <ValidateAdminCodeSignatures>false</ValidateAdminCodeSignatures>
  <!-- Determines whether to enforce code signature validation for elevated applications:
       true  = Require valid code signature
       false = No signature validation required -->
  <EnableVirtualization>true</EnableVirtualization>
  <!-- Enables or disables file and registry virtualization for legacy applications:
       true  = Virtualization enabled (default)
       false = Virtualization disabled -->
</component>
